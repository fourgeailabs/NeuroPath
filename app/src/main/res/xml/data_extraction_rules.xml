<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+).

   NeuroPath stores children's names, learning records, and chat transcripts in its
   Room database, and the parent PIN hash + Hugging Face token in encrypted shared
   preferences ("neuropath_secure_prefs").
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Child learning data: never uploaded to Google cloud backup. -->
        <exclude domain="database" path="." />
        <!-- Secrets: device-bound via AndroidKeyStore; the file is useless off-device. -->
        <exclude domain="sharedpref" path="neuropath_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Progress transfers to the child's new device; secrets do not roam. -->
        <exclude domain="sharedpref" path="neuropath_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
